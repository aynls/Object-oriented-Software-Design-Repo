{
  "name": "ripple-source-presentation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:cloudflare": "tsc --noEmit && vite build --mode cloudflare",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "preview": "vite preview --host 127.0.0.1 --port 5186 --strictPort"
  },
  "dependencies": {
    "motion": "^14.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "wrangler": "^4.152.0"
  }
}
